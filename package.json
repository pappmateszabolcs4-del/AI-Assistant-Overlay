{
  "name": "aigameassistant_new",
  "version": "1.0.0",
  "description": "AI Game Assistant - gaming overlay with AI help",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set APP_ENV=development && electron .",
    "prod": "set APP_ENV=production && electron .",
    "build:games": "node scripts/build-igdb-dataset.js",
    "validate:games": "node scripts/validate-game-detect.js",
    "package": "electron-forge package",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "check": "node bug-checker.js",
    "cleanup": "node cleanup.js",
    "test": "node --test"
  },
  "keywords": [],
  "author": "AI Game Assistant",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "electron": "^40.1.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "keytar": "^7.9.0",
    "openai": "^6.17.0"
  }
}
